#!/bin/sh
# Starts j-redis-server:  bin/j-redis-server [config-file] [--directive value ...]
# JAVA_HOME selects the JDK (Java 8 or newer); JREDIS_JAVA_OPTS replaces the default JVM options.
BASE=$(cd "$(dirname "$0")/.." && pwd)
if [ -n "${JAVA_HOME:-}" ]; then JAVA="$JAVA_HOME/bin/java"; else JAVA=java; fi
: "${JREDIS_JAVA_OPTS:=-Xms1g -Xmx1g -XX:+UseG1GC -XX:MaxGCPauseMillis=20}"
# shellcheck disable=SC2086  # the options are meant to be split into words
exec "$JAVA" $JREDIS_JAVA_OPTS -jar "$BASE/lib/j-redis-server.jar" "$@"
